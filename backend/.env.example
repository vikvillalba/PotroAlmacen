# ---------------------------------------------------------------------
# Variables de entorno para desarrollo local.
# 1. Copia este archivo como .env (en esta misma carpeta, backend/).
# 2. Cambia las contraseñas. El archivo .env está en el .gitignore.
#
# El mismo .env lo leen docker compose (para crear la base) y Spring Boot
# (para conectarse), así que ambos siempre usan las mismas credenciales.
# ---------------------------------------------------------------------

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3307
DB_NAME=potro_almacen

# Usuario de la aplicación (no es root)
DB_USER=potro_app
DB_PASSWORD=cambia_esta_contrasena

# Contraseña de root del contenedor (solo la usa docker compose)
DB_ROOT_PASSWORD=cambia_esta_contrasena_root
